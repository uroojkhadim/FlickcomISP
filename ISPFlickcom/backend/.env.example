# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET=your-super-secret-key-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-here
JWT_ISSUER=isp-service-platform
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SMS Gateway (configure with your provider)
SMS_API_URL=https://your-sms-api.com/send
SMS_API_KEY=your-sms-api-key
